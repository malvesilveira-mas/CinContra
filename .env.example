# ==============================================================================
# CinContra — Variáveis de Ambiente (Docker Compose)
# ==============================================================================

# URL do banco SQLite no backend (persistido no volume sqlite_data:/app/data)
DATABASE_URL=sqlite:////app/data/squads.db

# Porta exposta no host para o backend FastAPI
BACKEND_PORT=8000

# Porta exposta no host para o frontend Nginx (ex: 3000 ou 8080)
FRONTEND_PORT=3000

# URL base da API no frontend.
# Deixe vazio ("") para usar caminhos relativos via Proxy Reverso do Nginx (/api/, /professionals, /recommend, /simulate).
VITE_API_URL=
